#!/bin/sh
#
# Kairo Gradle Wrapper launcher (POSIX)
# Invokes Gradle 8.10.2 reproducibly across developer machines and CI.
#

set -eu

APP_HOME=$(cd "$(dirname "$0")" && pwd -P)
WRAPPER_JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

if [ ! -f "$WRAPPER_JAR" ]; then
  echo "gradle-wrapper.jar not found at $WRAPPER_JAR."
  echo "Run 'gradle wrapper --gradle-version 8.10.2' once with a local Gradle install to materialize the wrapper binary, or execute 'gradle $@'."
  if command -v gradle >/dev/null 2>&1; then
    exec gradle "$@"
  fi
  exit 1
fi

exec java -Xmx64m -Xms64m -jar "$WRAPPER_JAR" "$@"
